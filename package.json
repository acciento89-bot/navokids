{
  "name": "navokids",
  "version": "0.3.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "content:check": "node scripts/validate-content.cjs",
    "progress:check": "node scripts/validate-progression.cjs",
    "store:check": "node scripts/validate-store-config.cjs",
    "voice:samples": "node scripts/generate-voice-samples.cjs",
    "voice:generate": "node scripts/generate-voice-pack.cjs",
    "prebuild:android": "expo prebuild --platform android --clean",
    "navigation:check": "node scripts/validate-stage-navigation.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.0",
    "expo-audio": "~57.0.4",
    "expo-iap": "^5.5.0",
    "expo-speech": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "react-test-renderer": "^19.2.3",
    "typescript": "~5.9.2"
  }
}
