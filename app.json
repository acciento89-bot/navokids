{
  "expo": {
    "name": "NavoKids – Lerninseln",
    "slug": "navokids",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-iap",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kamilunavo.navokids",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kamilunavo.navokids",
      "versionCode": 5,
      "permissions": []
    },
    "extra": {
      "eas": {
        "projectId": "f5a27773-ed29-4bf3-a66f-8ad867b183b7"
      }
    },
    "owner": "acciento"
  }
}
