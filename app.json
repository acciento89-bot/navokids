{
  "expo": {
    "name": "NavoKids – Lerninseln",
    "slug": "navokids",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/navi-mascot-optimized.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E8"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": ["expo-iap"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kamilunavo.navokids",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kamilunavo.navokids",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#25C7C8"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro"
    }
  }
}
