{
  "expo": {
    "name": "NavoKids – Lerninseln",
    "slug": "navokids",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/navi-mascot-optimized.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E8"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": ["expo-iap"],
