      "supportsTablet": true,
      "bundleIdentifier": "com.kamilunavo.navokids",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kamilunavo.navokids",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#25C7C8"
      },
      "permissions": []
    },
    "extra": {
      "eas": {
        "projectId": "f5a27773-ed29-4bf3-a66f-8ad867b183b7"
      }
    },
    "owner": "acciento"
  }
}
